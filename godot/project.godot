; Development data inspector and recovery verification harness; not the game port.
config_version=5

[application]
config/name="Recovered Client Data Inspector"
run/main_scene="res://data_inspector/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=720
window/size/viewport_height=1100
window/size/window_width_override=520
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
